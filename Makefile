CC := gcc
SRCDIR := src
BUILDDIR := build
TESTDIR := tests
TARGET := bin/run
TESTTARGET := bin/tester
SRCEXT := c
SOURCES := $(shell find $(SRCDIR) -type f -name '*.$(SRCEXT)')
OBJECTS := $(patsubst $(SRCDIR)/%,$(BUILDDIR)/%,$(SOURCES:.$(SRCEXT)=.o))
DEPS := $(OBJECTS:.o=.d)
LIBOBJECTS := $(filter-out $(BUILDDIR)/main.o,$(OBJECTS))
CFLAGS := -O0 -Wall -Wextra
LIB := -L lib
INC := -I include

all: $(TARGET)

$(TARGET): $(OBJECTS)
	@echo " Linking..."
	@mkdir -p $(dir $@)
	@echo " $(CC) $^ -o $@ $(LIB)"; $(CC) $^ -o $@ $(LIB) -lm

$(BUILDDIR)/%.o: $(SRCDIR)/%.$(SRCEXT)
	@echo " Building..."
	@mkdir -p $(dir $@)
	@echo " $(CC) $(CFLAGS) $(INC) -c -o $@ $<"; $(CC) $(CFLAGS) $(INC) -MMD -MP -c -o $@ $< -save-temps=obj

# Debug build. Recursive make so the rebuild cannot race the clean under -j.
debug:
	@$(MAKE) clean
	@$(MAKE) CFLAGS="$(CFLAGS) -g" all

clean:
	@echo " Cleaning..."
	@echo " $(RM) -r $(BUILDDIR) $(TARGET) $(TESTTARGET)"; $(RM) -r $(BUILDDIR) $(TARGET) $(TESTTARGET)

# Tests. Links the library objects but not main.o, which has its own main().
$(TESTTARGET): $(TESTDIR)/test_add.$(SRCEXT) $(LIBOBJECTS)
	@echo " Building tests..."
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(INC) $^ -o $@ $(LIB)

test: $(TESTTARGET)
	./$(TESTTARGET) && echo " All tests passed."

# Header dependencies generated by -MMD -MP.
-include $(DEPS)

.PHONY: all clean debug test